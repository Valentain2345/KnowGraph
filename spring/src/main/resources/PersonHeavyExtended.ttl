PREFIX :       <http://example.org/>
PREFIX Person: <http://example.org/Person/>
PREFIX Phone:  <http://example.org/Phone/>
PREFIX owl:    <http://www.w3.org/2002/07/owl#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xml:    <http://www.w3.org/XML/1998/namespace>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

:       rdf:type  owl:Ontology .

Person:ref-phone  rdf:type  owl:ObjectProperty;
        rdfs:domain  :Person;
        rdfs:range   :Phone .

Phone:ref-owner  rdf:type  owl:ObjectProperty;
        rdfs:domain  :Phone;
        rdfs:range   :Person .

Person:birthDate  rdf:type  owl:DatatypeProperty;
        rdfs:domain  :Person;
        rdfs:range   xsd:dateTime .

Person:name  rdf:type  owl:DatatypeProperty;
        rdfs:domain  :Person;
        rdfs:range   xsd:string .

Person:personID  rdf:type  owl:DatatypeProperty;
        rdfs:domain  :Person;
        rdfs:range   xsd:integer .

Person:sex  rdf:type  owl:DatatypeProperty;
        rdfs:domain  :Person;
        rdfs:range   xsd:boolean .

Person:weight  rdf:type  owl:DatatypeProperty;
        rdfs:domain  :Person;
        rdfs:range   xsd:double .

Phone:number  rdf:type  owl:DatatypeProperty;
        rdfs:domain  :Phone;
        rdfs:range   xsd:string .

Phone:owner  rdf:type  owl:DatatypeProperty;
        rdfs:domain  :Phone;
        rdfs:range   xsd:integer .

Phone:phoneID  rdf:type  owl:DatatypeProperty;
        rdfs:domain  :Phone;
        rdfs:range   xsd:integer .

Phone:price  rdf:type  owl:DatatypeProperty;
        rdfs:domain  :Phone;
        rdfs:range   xsd:double .

:HeavyYoungMan  rdf:type  owl:Class;
        rdfs:subClassOf  :Person .

:Person  rdf:type  owl:Class .

:Phone  rdf:type  owl:Class .

<http://example.org/Person/personID=1>
        rdf:type          owl:NamedIndividual , :HeavyYoungMan , :Person;
        Person:birthDate  "2001-01-01T00:00:00"^^xsd:dateTime;
        Person:name       "John";
        Person:personID   1;
        Person:ref-phone  <http://example.org/Phone/phoneID=1> , <http://example.org/Phone/phoneID=2>;
